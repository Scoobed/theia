# Wrapper image: adds SBOM and LICENSE to the upstream zookeeper image.
ARG UPSTREAM_TAG=latest
FROM docker.io/zookeeper:${UPSTREAM_TAG}

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="theia-zookeeper: zookeeper repackaged with SBOM and LICENSE."

USER root

# Generate SPDX SBOM for the installed binaries
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin && \
    syft / --exclude '/proc' --exclude '/sys' -o spdx-json=/sbom.spdx.json && \
    rm /usr/local/bin/syft

COPY LICENSE /LICENSE

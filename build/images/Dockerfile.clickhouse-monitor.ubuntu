ARG GO_VERSION=latest
FROM golang:${GO_VERSION} AS clickhouse-monitor-build

COPY . /theia
WORKDIR /theia

# Statically links clickhouse-monitor-plugin binary using vendored deps.
RUN CGO_ENABLED=0 GOFLAGS=-mod=vendor make clickhouse-monitor-plugin

# Generate SPDX SBOM for the binary
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin && \
    syft /theia/bin/clickhouse-monitor -o spdx-json=/theia/sbom.spdx.json

# Minimal scratch image - zero CVEs, no OS packages
FROM scratch

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="A docker image to deploy the ClickHouse monitor plugin."

# CA certs required for TLS connections to Kubernetes API
COPY --from=clickhouse-monitor-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=clickhouse-monitor-build /theia/bin/clickhouse-monitor /clickhouse-monitor
COPY --from=clickhouse-monitor-build /theia/sbom.spdx.json /sbom.spdx.json
COPY LICENSE /LICENSE

ENTRYPOINT ["/clickhouse-monitor"]

# Wrapper: adds /sbom.spdx.json and /LICENSE to clickhouse/clickhouse-server.
# Multi-stage ensures this works with both standard and distroless variants.
ARG UPSTREAM_TAG=latest

FROM docker.io/clickhouse/clickhouse-server:${UPSTREAM_TAG} AS upstream

FROM alpine:latest AS sbom-generator
RUN apk add --no-cache curl
COPY --from=upstream / /upstream/
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | \
    sh -s -- -b /usr/local/bin && \
    cd /upstream && syft . \
      --exclude './proc' \
      --exclude './sys' \
      --exclude './dev' \
      -o spdx-json=/sbom.spdx.json

FROM docker.io/clickhouse/clickhouse-server:${UPSTREAM_TAG}

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="theia-clickhouse-server-upstream: clickhouse-server with SBOM and LICENSE."

COPY --from=sbom-generator /sbom.spdx.json /sbom.spdx.json
COPY LICENSE /LICENSE

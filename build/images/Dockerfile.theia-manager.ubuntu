ARG GO_VERSION=latest
FROM golang:${GO_VERSION} AS theia-manager-build

COPY . /theia
WORKDIR /theia

RUN CGO_ENABLED=0 GOFLAGS=-mod=vendor make theia-manager-bin
RUN mkdir theia-manager-coverage

# Generate SPDX SBOM for the binary
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin && \
    syft /theia/bin/theia-manager -o spdx-json=/theia/sbom.spdx.json

# Minimal scratch image - zero CVEs, no OS packages
FROM scratch

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="A docker image to deploy theia manager."

# CA certs required for TLS connections to Kubernetes API
COPY --from=theia-manager-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=theia-manager-build /theia/bin/theia-manager /theia-manager
COPY --from=theia-manager-build /theia/sbom.spdx.json /sbom.spdx.json
COPY LICENSE /LICENSE

ENTRYPOINT ["/theia-manager"]

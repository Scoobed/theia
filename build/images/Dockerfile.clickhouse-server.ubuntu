ARG GO_VERSION=latest
FROM golang:${GO_VERSION} AS clickhouse-schema-management-build

COPY . /theia
WORKDIR /theia

RUN GOFLAGS=-mod=vendor make clickhouse-schema-management-plugin

# Generate SPDX SBOM for the binary
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin && \
    syft /theia/bin/clickhouse-schema-management -o spdx-json=/theia/sbom.spdx.json

# Use ClickHouse's official distroless variant - minimal attack surface
FROM docker.io/clickhouse/clickhouse-server:25.8.28.1-distroless

LABEL maintainer="Antrea <projectantrea-dev@googlegroups.com>"
LABEL description="A docker image to deploy the ClickHouse server."

COPY --from=clickhouse-schema-management-build /theia/bin/clickhouse-schema-management /
COPY --from=clickhouse-schema-management-build /theia/sbom.spdx.json /sbom.spdx.json
COPY LICENSE /LICENSE
